<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="LLMTask">
  <BehaviorTree ID="LLMTask">
    <Sequence name="LLMSequence">
      <Takeoff goal="0.0;0.0;1.0"/>
      <!-- ????????????????????? -->
      <GoTo goal="0.0;-1.0;1.0"/>
      <!-- ???????????????????????????????????????????????? 2 s ?????? -->
      <WaitForStablePosition goal="0.0;-1.0;1.0" position_threshold="0.150000" velocity_threshold="0.080000" stable_confirm_time="0.500000" timeout="2.000000"/>
      <!-- ?????????????????? -->
      <TargetLocator object_name="square_frame" object_width="1.300000" object_height="1.300000" occlusion_direction="right" expected_pos="3.25;-0.4;1.0" xy_tolerance="1.0" z_tolerance="0.500000" confidence_threshold="0.7" position_3d="{frame_center}" filter_window_size="20"/>
      <!-- ?????????????????? -->
      <PlanningControl goal="{frame_center}" offset_z="1.000000" final_position="{planning_end_pos}"/>
      <GoTo goal="4.5;0.5;1.2"/>
      <Parallel success_count="2" failure_count="1">
        <GoTo goal="4.5;0.5;1.2"/>
        <ArucoDetector aruco_id="{detected_aruco_id}"/>
      </Parallel>
      <!-- ??????180??? -->
      <GoTo goal="4.5;0.5;1.8" yaw="3.141590"/>
      <!-- ?????????????????? -->
      <GoTo goal="{planning_end_pos}"/>
      <!-- ?????????????????? -->
      <PlanningControl goal="{frame_center}"/>
      <!-- ??????????????? -->
      <GoTo goal="0.5;0.0;0.0" frame="1"/>
      <!-- ???????????????????????? -->
      <GoTo goal="0.5;0.0;0.0" frame="1" yaw="0.000000"/>
      <!-- ??????????????????????????????A -->
      <PlanningControl goal="5.3;1.0;1.5"/>
      <!-- ????????????A?????????(red) -->
      <GoTo goal="5.3;1.0;1.0" yaw="3.141590"/>
      <!-- ????????????????????? -->
      <ForceSuccess>
        <Timeout msec="50000">
          <Parallel success_count="1" failure_count="1">
            <TargetTracker object_name="red_balloon" confidence_threshold="0.8" pixel_target="{balloon_pixel}"/>
            <VisualServo pixel_target="{balloon_pixel}" target_color="red" k_p_yaw_rate="0.003000" k_d_yaw_rate="0.001000" k_p_vz="0.010000" k_d_vz="0.006000" approach_area_threshold="0.080000" forward_velocity="1.000000" sprint_velocity="1.500000" sprint_time="1.200000"/>
          </Parallel>
        </Timeout>
      </ForceSuccess>
      <!-- ???????????? -->
      <GoTo goal="0.0;0.0;0.5" yaw="0.000000"/>
      <!-- ?????? -->
      <Land/>
    </Sequence>
  </BehaviorTree>
</root>